rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function callerDoc() {
      return /databases/$(database)/documents/members/$(request.auth.token.email);
    }

    // Signed in AND listed as an active member. Firebase Auth sign-up has to
    // stay open (members are created from the browser), so a bare login proves
    // nothing — every data rule goes through this, and deactivating a member
    // revokes their access here, not just in the UI.
    function isActiveMember() {
      return isAuthenticated() &&
        exists(callerDoc()) &&
        get(callerDoc()).data.isActive == true;
    }

    // secretary, president, or superAdmin  →  full admin access
    function isAdmin() {
      return isActiveMember() &&
        get(callerDoc()).data.role in ['secretary', 'president', 'superAdmin'];
    }

    // only superAdmin can touch accounts that carry the superAdmin role
    function isSuperAdmin() {
      return isActiveMember() &&
        get(callerDoc()).data.role == 'superAdmin';
    }

    // ── Members ──────────────────────────────────────────────────────────────
    match /members/{memberEmail} {
      // A user reads their own doc (even when inactive, so the app can show
      // "access denied" and sign them out); admins read all
      allow read: if request.auth.token.email == memberEmail || isAdmin();

      // Any admin can create a member, UNLESS they're assigning the superAdmin role
      allow create: if isAdmin() &&
        (request.resource.data.role != 'superAdmin' || isSuperAdmin());

      // Any admin can update, BUT:
      //   • cannot change a role TO superAdmin (unless they're superAdmin)
      //   • cannot change a role FROM superAdmin (unless they're superAdmin)
      allow update: if (isAdmin() && (
        (resource.data.role != 'superAdmin' && request.resource.data.role != 'superAdmin') ||
        isSuperAdmin()
      )) ||
        // A member may update ONLY their own profilePhoto field — nothing else
        // (role, isActive, email, etc. stay admin-only, preventing self-promotion),
        // and only to a Firebase Storage URL (no outside tracking images).
        (isActiveMember() && request.auth.token.email == memberEmail &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profilePhoto']) &&
         request.resource.data.profilePhoto is string &&
         (request.resource.data.profilePhoto == '' ||
          request.resource.data.profilePhoto.matches('https://firebasestorage[.]googleapis[.]com/.*')));

      // Only superAdmin can permanently remove a member — and not themselves,
      // so the club can't be left without a Super Admin by accident
      allow delete: if isSuperAdmin() && request.auth.token.email != memberEmail;
    }

    // ── Events ───────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read:                     if isActiveMember();
      allow create, update, delete:   if isAdmin();
    }

    // ── Attendance ───────────────────────────────────────────────────────────
    match /attendance/{attendanceId} {
      allow read: if isActiveMember() && (
        resource.data.memberId == request.auth.token.email || isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    // ── Manual points ────────────────────────────────────────────────────────
    match /memberPoints/{pointId} {
      allow read: if isActiveMember() && (
        resource.data.memberId == request.auth.token.email || isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    // ── Published leaderboard ───────────────────────────────────────────────
    // Summary (names, positions, points — no emails/phones) computed by admins
    // from data members can't read directly. Everyone active can view it.
    match /leaderboard/{docId} {
      allow read:  if isActiveMember();
      allow write: if isAdmin() &&
        request.resource.data.rows is list &&
        request.resource.data.rows.size() <= 1000;
    }

    // ── Projects ─────────────────────────────────────────────────────────────
    // Every active member can view; admins add, edit and remove. Role holders
    // are stored as { key, name } (no emails). The image must be in Storage.
    match /projects/{projectId} {
      allow read: if isActiveMember();
      allow create, update: if isAdmin() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 150 &&
        request.resource.data.imageUrl is string &&
        (request.resource.data.imageUrl == '' ||
         request.resource.data.imageUrl.matches('https://firebasestorage[.]googleapis[.]com/.*'));
      allow delete: if isAdmin();
    }

    // ── Orientation Program files ───────────────────────────────────────────
    // Every active member can view; admins add and remove. The url must point
    // at Firebase Storage (rendered as a link for all members).
    match /orientation/{fileId} {
      allow read: if isActiveMember();
      allow create, update: if isAdmin() &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 150 &&
        request.resource.data.url is string &&
        request.resource.data.url.matches('https://firebasestorage[.]googleapis[.]com/.*');
      allow delete: if isAdmin();
    }

    // ── Notice Board ─────────────────────────────────────────────────────────
    // Every active member can view; admins post, edit and remove. The card
    // image must be in Storage and the optional link a plain https:// link.
    match /notices/{noticeId} {
      allow read: if isActiveMember();
      allow create, update: if isAdmin() &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 150 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 3000 &&
        request.resource.data.imageUrl is string &&
        (request.resource.data.imageUrl == '' ||
         request.resource.data.imageUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')) &&
        request.resource.data.link is string &&
        (request.resource.data.link == '' || request.resource.data.link.matches('https://.*'));
      allow delete: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
