rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function callerDoc() {
      return /databases/$(database)/documents/members/$(request.auth.token.email);
    }

    // Signed in AND listed as an active member. Firebase Auth sign-up has to
    // stay open (members are created from the browser), so a bare login proves
    // nothing — every data rule goes through this, and deactivating a member
    // revokes their access here, not just in the UI.
    function isActiveMember() {
      return isAuthenticated() &&
        exists(callerDoc()) &&
        get(callerDoc()).data.isActive == true;
    }

    // secretary, president, or superAdmin  →  full admin access
    function isAdmin() {
      return isActiveMember() &&
        get(callerDoc()).data.role in ['secretary', 'president', 'superAdmin'];
    }

    // only superAdmin can touch accounts that carry the superAdmin role
    function isSuperAdmin() {
      return isActiveMember() &&
        get(callerDoc()).data.role == 'superAdmin';
    }

    // ── Members ──────────────────────────────────────────────────────────────
    match /members/{memberEmail} {
      // A user reads their own doc (even when inactive, so the app can show
      // "access denied" and sign them out); admins read all
      allow read: if request.auth.token.email == memberEmail || isAdmin();

      // Any admin can create a member, UNLESS they're assigning the superAdmin role
      allow create: if isAdmin() &&
        (request.resource.data.role != 'superAdmin' || isSuperAdmin());

      // Any admin can update, BUT:
      //   • cannot change a role TO superAdmin (unless they're superAdmin)
      //   • cannot change a role FROM superAdmin (unless they're superAdmin)
      allow update: if (isAdmin() && (
        (resource.data.role != 'superAdmin' && request.resource.data.role != 'superAdmin') ||
        isSuperAdmin()
      )) ||
        // A member may update ONLY their own profilePhoto field — nothing else
        // (role, isActive, email, etc. stay admin-only, preventing self-promotion),
        // and only to a Firebase Storage URL (no outside tracking images).
        (isActiveMember() && request.auth.token.email == memberEmail &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profilePhoto']) &&
         request.resource.data.profilePhoto is string &&
         (request.resource.data.profilePhoto == '' ||
          request.resource.data.profilePhoto.matches('https://firebasestorage[.]googleapis[.]com/.*')));

      // Only superAdmin can permanently remove a member — and not themselves,
      // so the club can't be left without a Super Admin by accident
      allow delete: if isSuperAdmin() && request.auth.token.email != memberEmail;
    }

    // ── Events ───────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read:                     if isActiveMember();
      allow create, update, delete:   if isAdmin();
    }

    // ── Attendance ───────────────────────────────────────────────────────────
    match /attendance/{attendanceId} {
      allow read: if isActiveMember() && (
        resource.data.memberId == request.auth.token.email || isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    // ── Manual points ────────────────────────────────────────────────────────
    match /memberPoints/{pointId} {
      allow read: if isActiveMember() && (
        resource.data.memberId == request.auth.token.email || isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
