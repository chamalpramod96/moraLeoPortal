# Firebase Configuration
# Copy this file to .env and fill in your Firebase project credentials.
# Get these values from: Firebase Console → Project Settings → Your apps → Web app

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# Demo Mode (development only)
# Set to 'true' for local testing with mock data, 'false' for production
VITE_DEMO_MODE=false
# VITE_DEMO_PASSWORD=your-demo-password  (Only used when VITE_DEMO_MODE=true)
