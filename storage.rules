rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers: the caller's member record in Firestore ────────────────────
    // A missing member doc makes firestore.get() fail, which denies access.
    function callerMember() {
      return firestore.get(
        /databases/(default)/documents/members/$(request.auth.token.email)
      ).data;
    }

    // Signed in AND an active member (sign-up is open, so a login alone
    // proves nothing; deactivated members lose access here too)
    function isActiveMember() {
      return request.auth != null && callerMember().isActive == true;
    }

    function isAdmin() {
      return isActiveMember() &&
        callerMember().role in ['secretary', 'president', 'superAdmin'];
    }

    function isSuperAdmin() {
      return isActiveMember() && callerMember().role == 'superAdmin';
    }

    // Photo formats only — no SVG (it can carry script) or other image/* types
    function isPhoto() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif)');
    }

    // ── Profile photos ──────────────────────────────────────────────────────
    // Path: profiles/{email}/photo
    // • Any active member can READ (needed to display in portal, Word doc)
    // • Members can WRITE their own photo; admins can write any member's photo
    // • Max file size: 5 MB — enforced by rule
    // • Only superAdmin can DELETE (part of permanently removing a member)
    match /profiles/{email}/photo {
      allow read:  if isActiveMember();
      allow write: if isActiveMember()
        && request.resource.size  < 5 * 1024 * 1024      // 5 MB max
        && isPhoto()
        && (request.auth.token.email == email || isAdmin());
      allow delete: if isSuperAdmin();
    }

    // ── Event photos ─────────────────────────────────────────────────────────
    // Path: events/{eventId}/{filename}
    // • Any active member can READ
    // • Only admins can WRITE / DELETE
    // • Max file size: 10 MB
    match /events/{eventId}/{filename} {
      allow read:   if isActiveMember();
      allow write:  if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && isPhoto();
      allow delete: if isAdmin();
    }

    // ── Orientation Program files ───────────────────────────────────────────
    // Path: orientation/{fileId}/{fileName}
    // • Any active member can READ
    // • Only admins can upload (documents, images, MP4; max 25 MB) or DELETE
    //   — keep the type list in sync with ORIENTATION_TYPES in orientationService.js
    match /orientation/{fileId}/{fileName} {
      allow read:   if isActiveMember();
      allow write:  if isAdmin()
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches(
             'application/pdf|application/msword|application/vnd[.]ms-(powerpoint|excel)' +
             '|application/vnd[.]openxmlformats-officedocument[.](wordprocessingml[.]document|presentationml[.]presentation|spreadsheetml[.]sheet)' +
             '|image/(jpeg|png|webp)|video/mp4');
      allow delete: if isAdmin();
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
